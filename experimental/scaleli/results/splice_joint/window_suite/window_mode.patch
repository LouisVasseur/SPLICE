+// Window-mode scaling, all integer. scale_shift: round(log2(scale_as / n)), 0 when off; scaled_bytes: b * n / scale_as.
+inline unsigned scale_shift(const SpliceParams& p, std::uint64_t n) {
+    if (!p.scale_as || !n || p.scale_as <= n) return 0;
+    unsigned s = 0;
+    while (s < 40 && (static_cast<unsigned __int128>(n) << (s + 1)) <= p.scale_as) ++s;   // n 2^s <= scale_as < n 2^(s+1)
+    const auto lo = static_cast<unsigned __int128>(n) << s;
