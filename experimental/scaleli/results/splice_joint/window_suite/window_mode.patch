+    par_for(nc, threads, [&](std::size_t c) {
+        Count cnt(ix.view());
+        for (std::size_t i = c * ch; i < std::min(n, (c + 1) * ch); ++i) { std::uint64_t v; get_impl(ix.view(), k[i], v, cnt); }
